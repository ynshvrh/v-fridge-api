# V-Fridge API — local configuration overrides.
# Copy to `.env` (gitignored) and fill in the blanks.
#
# Convention: ASP.NET Core reads environment variables in the same shape as appsettings.json,
# with `:` replaced by `__` (double underscore). Examples:
#   appsettings.json -> "Email": { "Password": "..." }
#   .env             -> Email__Password=...
#
# Anything set here overrides appsettings.json and user-secrets. Production should set these
# via the deploy environment (Docker, systemd, Azure, …) instead of a .env file.

# --- Database ---
ConnectionStrings__Default=Host=localhost;Port=5432;Database=V-Fridge;Username=postgres;Password=postgres;SslMode=Disable;Pooling=true

# --- JWT signing ---
# Generate with: openssl rand -base64 48
Jwt__Secret=
Jwt__Issuer=v-fridge-api
Jwt__Audience=v-fridge-web
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=30

# --- Frontend (used in CORS + verification redirect link) ---
Frontend__BaseUrl=http://localhost:3000
Cors__AllowedOrigins__0=http://localhost:3000

# --- OpenRouter (AI chef + meal planner) ---
# Models are tried in order (index 0 first); the service falls through to the next
# on rate-limit (429), out-of-credit (402), error, empty reply, or — for the planner
# — invalid JSON. This keeps a free-tier account up across several models' separate
# daily limits without paying. Only list individually-competent models: the chain
# rescues from outages, not from a weak model's bad output (gpt-4o-mini dropped meals
# and mistranslated category codes — do not add it). Verify each is live + free on
# OpenRouter before relying on it. If Models is unset, Model is used as a single fallback.
OpenRouter__ApiKey=
OpenRouter__Model=google/gemini-2.5-flash
OpenRouter__Models__0=meta-llama/llama-4-maverick:free
OpenRouter__Models__1=deepseek/deepseek-chat-v3-0324:free
OpenRouter__Models__2=google/gemini-2.0-flash-exp:free

# --- Email (MailKit SMTP) ---
# For Gmail: enable 2FA, then create an App Password at https://myaccount.google.com/apppasswords
Email__From=
Email__DisplayName=V-Fridge
Email__SmtpHost=smtp.gmail.com
Email__SmtpPort=587
Email__Username=
Email__Password=
Email__UseStartTls=true

# --- Google OAuth (for POST /auth/google) ---
Google__ClientId=
Google__ClientSecret=
